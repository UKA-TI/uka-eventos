# Local web and API
API_PORT=3001
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Local MySQL. Confirm the GoDaddy MySQL version before deployment.
MYSQL_IMAGE=mysql:8.0
MYSQL_PORT=3306
MYSQL_DATABASE=uka_eventos
MYSQL_USER=uka_app
MYSQL_PASSWORD=uka_local_dev
MYSQL_ROOT_PASSWORD=uka_local_root
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uka_eventos
DB_USER=uka_app
DB_PASSWORD=uka_local_dev

# Local email capture (Mailpit)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Copia este archivo como .env para desarrollo local. No guardes secretos en Git.
API_PORT=3001
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
SESSION_SECRET=
SESSION_TTL_HOURS=8

# Base de datos MariaDB/MySQL (GoDaddy usa MariaDB 10.11).
DATABASE_URL=mysql://uka_app:uka_local_dev@127.0.0.1:3306/uka_eventos
SHADOW_DATABASE_URL=mysql://uka_app:uka_local_dev@127.0.0.1:3306/uka_eventos_shadow

# Inicio de sesión con Microsoft (Entra ID). No son secretos, pero van por entorno.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Correo del primer administrador. Solo se usa si todavía no hay ninguno.
BOOTSTRAP_ADMIN_EMAIL=

# Secreto para derivar los tokens de los pases (32 caracteres o más). Si cambia,
# los QR ya emitidos dejan de funcionar.
PASS_TOKEN_SECRET=
# Dirección pública usada en las ligas de los correos.
PUBLIC_BASE_URL=http://localhost:5173

# Correo con Microsoft Graph. Sin estos datos, los mensajes esperan en la cola.
MAIL_FROM=eventos@unkilodeayuda.org.mx
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
MAIL_RATE_PER_MINUTE=25
MAIL_DAILY_LIMIT=8000

# Botones de acceso sin Microsoft, SOLO para desarrollo local.
# La API se niega a arrancar en producción si está activo.
DEV_LOGIN_ENABLED=false

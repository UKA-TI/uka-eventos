{
  "name": "@uka/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:generate && tsx watch src/server.ts",
    "build": "npm run db:generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "npm run db:generate && tsc -p tsconfig.json --noEmit",
    "test": "npm run db:generate && vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:folio-integration": "npm run db:generate && tsx test/folio.integration.ts",
    "test:folio-coverage": "npm run db:generate && vitest run --coverage --coverage.include=src/modules/folios/folio-service.ts --coverage.lines=90 --coverage.functions=90 --coverage.branches=90 --coverage.statements=90",
    "test:db-integration": "npm run db:generate && cross-env RUN_DB_TESTS=1 vitest run test/access.integration.test.ts test/events.integration.test.ts test/orders.integration.test.ts test/checkin.integration.test.ts test/crm.integration.test.ts test/reconciled.integration.test.ts test/reports.integration.test.ts test/tables.integration.test.ts test/passes.integration.test.ts --no-file-parallelism"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@uka/shared": "0.1.0",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jose": "^6.2.15",
    "pdf-lib": "1.17.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "^1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "cross-env": "^10.1.0",
    "prisma": "^7.10.1",
    "supertest": "7.1.4",
    "tsx": "4.23.15",
    "vitest": "4.1.12"
  }
}

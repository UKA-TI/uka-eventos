generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Event {
  id               String          @id @default(cuid()) @db.VarChar(30)
  slug             String          @unique @db.VarChar(100)
  name             String          @db.VarChar(180)
  description      String?         @db.Text
  status           String          @default("draft") @db.VarChar(24)
  startsAt         DateTime?       @map("starts_at") @db.DateTime(3)
  endsAt           DateTime?       @map("ends_at") @db.DateTime(3)
  timeZone         String          @default("America/Mexico_City") @map("time_zone") @db.VarChar(64)
  venue            String?         @db.VarChar(180)
  capacity         Int?            @db.UnsignedInt
  folioPrefix      String?         @map("folio_prefix") @db.VarChar(3)
  feeAmount        Decimal?        @map("fee_amount") @db.Decimal(10, 2)
  currency         String          @default("MXN") @db.Char(3)
  companionLimit   Int             @default(0) @map("companion_limit") @db.UnsignedInt
  registrationMode String          @default("individual") @map("registration_mode") @db.VarChar(32)
  landingContent   Json?           @map("landing_content")
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  counters         EventCounter[]
  groupPurchases   GroupPurchase[]
  tables           Table[]
  registrations    Registration[]
  checkins         Checkin[]
  accessPoints     AccessPoint[]
  auditLogs        AuditLog[]

  @@index([status, startsAt])
  @@map("events")
}

model GroupPurchase {
  id            String         @id @default(cuid()) @db.VarChar(30)
  eventId       String         @map("event_id") @db.VarChar(30)
  tableId       String?        @map("table_id") @db.VarChar(30)
  company       String         @db.VarChar(180)
  contactName   String         @map("contact_name") @db.VarChar(180)
  contactEmail  String         @map("contact_email") @db.VarChar(254)
  maxSeats      Int            @map("max_seats") @db.UnsignedInt
  deadline      DateTime?      @db.DateTime(3)
  tokenHash     String?        @unique @map("token_hash") @db.Char(64)
  status        String         @default("draft") @db.VarChar(24)
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  event         Event          @relation(fields: [eventId], references: [id])
  table         Table?         @relation(fields: [tableId], references: [id])
  registrations Registration[]

  @@index([eventId, status])
  @@index([tableId])
  @@map("group_purchases")
}

model Table {
  id             String          @id @default(cuid()) @db.VarChar(30)
  eventId        String          @map("event_id") @db.VarChar(30)
  name           String          @db.VarChar(100)
  capacity       Int             @db.UnsignedInt
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  event          Event           @relation(fields: [eventId], references: [id])
  groupPurchases GroupPurchase[]
  registrations  Registration[]

  @@unique([eventId, name])
  @@index([eventId])
  @@map("event_tables")
}

model Guest {
  id            String         @id @default(cuid()) @db.VarChar(30)
  firstName     String         @map("first_name") @db.VarChar(100)
  lastName      String         @map("last_name") @db.VarChar(140)
  email         String?        @db.VarChar(254)
  phone         String?        @db.VarChar(32)
  organization  String?        @db.VarChar(180)
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  registrations Registration[]

  @@index([email])
  @@index([lastName, firstName])
  @@map("guests")
}

model Registration {
  id              String         @id @default(cuid()) @db.VarChar(30)
  eventId         String         @map("event_id") @db.VarChar(30)
  guestId         String         @map("guest_id") @db.VarChar(30)
  groupPurchaseId String?        @map("group_purchase_id") @db.VarChar(30)
  tableId         String?        @map("table_id") @db.VarChar(30)
  seatNumber      Int?           @map("seat_number") @db.UnsignedInt
  folio           String         @db.VarChar(16)
  status          String         @default("pending") @db.VarChar(24)
  registeredAt    DateTime       @default(now()) @map("registered_at") @db.DateTime(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  event           Event          @relation(fields: [eventId], references: [id])
  guest           Guest          @relation(fields: [guestId], references: [id])
  groupPurchase   GroupPurchase? @relation(fields: [groupPurchaseId], references: [id])
  table           Table?         @relation(fields: [tableId], references: [id])
  passes          Pass[]
  consents        Consent[]

  @@unique([eventId, folio])
  @@unique([groupPurchaseId, seatNumber])
  @@index([eventId, status])
  @@index([guestId])
  @@index([tableId])
  @@map("registrations")
}

model Pass {
  id             String       @id @default(cuid()) @db.VarChar(30)
  registrationId String       @map("registration_id") @db.VarChar(30)
  tokenHash      String       @unique @map("token_hash") @db.Char(64)
  status         String       @default("pending") @db.VarChar(24)
  issuedAt       DateTime     @default(now()) @map("issued_at") @db.DateTime(3)
  revokedAt      DateTime?    @map("revoked_at") @db.DateTime(3)
  registration   Registration @relation(fields: [registrationId], references: [id])
  checkin        Checkin?

  @@index([registrationId, status])
  @@map("passes")
}

model Checkin {
  id             String      @id @default(cuid()) @db.VarChar(30)
  eventId        String      @map("event_id") @db.VarChar(30)
  passId         String      @unique @map("pass_id") @db.VarChar(30)
  accessPointId  String      @map("access_point_id") @db.VarChar(30)
  operatorUserId String?     @map("operator_user_id") @db.VarChar(30)
  checkedInAt    DateTime    @default(now()) @map("checked_in_at") @db.DateTime(3)
  raffleFolio    String?     @map("raffle_folio") @db.VarChar(16)
  event          Event       @relation(fields: [eventId], references: [id])
  pass           Pass        @relation(fields: [passId], references: [id])
  accessPoint    AccessPoint @relation(fields: [accessPointId], references: [id])
  operator       User?       @relation("CheckinOperator", fields: [operatorUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, raffleFolio])
  @@index([eventId, checkedInAt])
  @@index([accessPointId, checkedInAt])
  @@map("checkins")
}

model EventCounter {
  id           String   @id @default(cuid()) @db.VarChar(30)
  eventId      String   @map("event_id") @db.VarChar(30)
  counterType  String   @map("counter_type") @db.VarChar(32)
  currentValue Int      @default(0) @map("current_value") @db.UnsignedInt
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  event        Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, counterType])
  @@map("event_counters")
}

model User {
  id           String     @id @default(cuid()) @db.VarChar(30)
  email        String     @unique @db.VarChar(254)
  displayName  String     @map("display_name") @db.VarChar(180)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  status       String     @default("active") @db.VarChar(24)
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  roles        UserRole[]
  checkins     Checkin[]  @relation("CheckinOperator")
  auditLogs    AuditLog[]

  @@map("users")
}

model Role {
  id          String     @id @default(cuid()) @db.VarChar(30)
  code        String     @unique @db.VarChar(32)
  name        String     @db.VarChar(80)
  description String?    @db.VarChar(255)
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.VarChar(30)
  roleId    String   @map("role_id") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model AccessPoint {
  id        String    @id @default(cuid()) @db.VarChar(30)
  eventId   String    @map("event_id") @db.VarChar(30)
  name      String    @db.VarChar(100)
  status    String    @default("active") @db.VarChar(24)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  event     Event     @relation(fields: [eventId], references: [id])
  checkins  Checkin[]

  @@unique([eventId, name])
  @@index([eventId, status])
  @@map("access_points")
}

model Consent {
  id             String       @id @default(cuid()) @db.VarChar(30)
  registrationId String       @map("registration_id") @db.VarChar(30)
  purpose        String       @db.VarChar(80)
  noticeVersion  String       @map("notice_version") @db.VarChar(40)
  granted        Boolean
  consentedAt    DateTime     @map("consented_at") @db.DateTime(3)
  withdrawnAt    DateTime?    @map("withdrawn_at") @db.DateTime(3)
  registration   Registration @relation(fields: [registrationId], references: [id])

  @@index([registrationId, purpose, consentedAt])
  @@map("consents")
}

model AuditLog {
  id         String   @id @default(cuid()) @db.VarChar(30)
  eventId    String?  @map("event_id") @db.VarChar(30)
  userId     String?  @map("user_id") @db.VarChar(30)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(30)
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  event      Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

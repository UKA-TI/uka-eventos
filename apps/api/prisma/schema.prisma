generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model EventSeries {
  id          String   @id @default(cuid()) @db.VarChar(30)
  name        String   @unique @db.VarChar(180)
  type        String   @db.VarChar(60)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  events      Event[]

  @@index([type])
  @@map("event_series")
}

model TicketType {
  id            String    @id @default(cuid()) @db.VarChar(30)
  eventId       String    @map("event_id") @db.VarChar(30)
  name          String    @db.VarChar(120)
  description   String?   @db.VarChar(500)
  price         Decimal   @default(0) @db.Decimal(10, 2)
  capacity      Int?      @db.UnsignedInt
  seatsIncluded Int       @default(1) @map("seats_included") @db.UnsignedInt
  salesStart    DateTime? @map("sales_start") @db.DateTime(3)
  salesEnd      DateTime? @map("sales_end") @db.DateTime(3)
  active        Boolean   @default(true)
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@unique([eventId, name])
  @@index([eventId, active])
  @@map("ticket_types")
}

model EventFormField {
  id        String   @id @default(cuid()) @db.VarChar(30)
  eventId   String   @map("event_id") @db.VarChar(30)
  label     String   @db.VarChar(120)
  type      String   @db.VarChar(20)
  required  Boolean  @default(false)
  options   Json
  helpText  String?  @map("help_text") @db.VarChar(255)
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
  @@map("event_form_fields")
}

model Event {
  id                  String              @id @default(cuid()) @db.VarChar(30)
  seriesId            String              @map("series_id") @db.VarChar(30)
  editionYear         Int                 @map("edition_year") @db.UnsignedSmallInt
  modules             Json
  slug                String              @unique @db.VarChar(100)
  name                String              @db.VarChar(180)
  description         String?             @db.Text
  status              String              @default("draft") @db.VarChar(24)
  startsAt            DateTime?           @map("starts_at") @db.DateTime(3)
  endsAt              DateTime?           @map("ends_at") @db.DateTime(3)
  timeZone            String              @default("America/Mexico_City") @map("time_zone") @db.VarChar(64)
  venue               String?             @db.VarChar(180)
  programStartsAt     DateTime?           @map("program_starts_at") @db.DateTime(3)
  mapUrl              String?             @map("map_url") @db.VarChar(500)
  reminderSentAt      DateTime?           @map("reminder_sent_at") @db.DateTime(3)
  seatingPublishedAt  DateTime?           @map("seating_published_at") @db.DateTime(3)
  paymentInstructions String?             @map("payment_instructions") @db.Text
  capacity            Int?                @db.UnsignedInt
  folioPrefix         String?             @map("folio_prefix") @db.VarChar(3)
  currency            String              @default("MXN") @db.Char(3)
  companionLimit      Int                 @default(0) @map("companion_limit") @db.UnsignedInt
  createdAt           DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  series              EventSeries         @relation(fields: [seriesId], references: [id])
  ticketTypes         TicketType[]
  formFields          EventFormField[]
  counters            EventCounter[]
  orders              Order[]
  emailMessages       EmailMessage[]
  incidents           Incident[]
  tables              EventTable[]
  seatingPreferences  SeatingPreference[]
  plan                EventPlan?
  registrations       Registration[]
  checkins            Checkin[]
  accessPoints        AccessPoint[]
  auditLogs           AuditLog[]
  campaigns           Campaign[]
  donations           Donation[]

  @@index([status, startsAt])
  @@index([seriesId, editionYear])
  @@map("events")
}

model Order {
  id                   String            @id @default(cuid()) @db.VarChar(30)
  eventId              String            @map("event_id") @db.VarChar(30)
  ticketTypeId         String            @map("ticket_type_id") @db.VarChar(30)
  buyerGuestId         String            @map("buyer_guest_id") @db.VarChar(30)
  createdById          String?           @map("created_by_id") @db.VarChar(30)
  reference            String            @db.VarChar(16)
  seats                Int               @db.UnsignedInt
  quantity             Int               @default(1) @db.UnsignedInt
  amountDue            Decimal           @map("amount_due") @db.Decimal(10, 2)
  status               String            @default("pending_payment") @db.VarChar(24)
  source               String            @db.VarChar(16)
  answers              Json
  groupTokenHash       String?           @unique @map("group_token_hash") @db.Char(64)
  delegateName         String?           @map("delegate_name") @db.VarChar(160)
  delegateEmail        String?           @map("delegate_email") @db.VarChar(254)
  registrationDeadline DateTime?         @map("registration_deadline") @db.DateTime(3)
  notes                String?           @db.VarChar(255)
  confirmedAt          DateTime?         @map("confirmed_at") @db.DateTime(3)
  cancelledAt          DateTime?         @map("cancelled_at") @db.DateTime(3)
  createdAt            DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  event                Event             @relation(fields: [eventId], references: [id])
  ticketType           TicketType        @relation(fields: [ticketTypeId], references: [id])
  buyer                Guest             @relation("OrderBuyer", fields: [buyerGuestId], references: [id])
  createdBy            User?             @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  registrations        Registration[]
  payments             Payment[]
  allocations          TableAllocation[]

  @@unique([eventId, reference])
  @@index([eventId, status])
  @@index([ticketTypeId, status])
  @@index([buyerGuestId])
  @@map("orders")
}

model Payment {
  id           String    @id @default(cuid()) @db.VarChar(30)
  orderId      String    @map("order_id") @db.VarChar(30)
  amount       Decimal   @db.Decimal(10, 2)
  method       String    @db.VarChar(16)
  reference    String?   @db.VarChar(120)
  notes        String?   @db.VarChar(500)
  paidAt       DateTime  @map("paid_at") @db.DateTime(3)
  recordedById String?   @map("recorded_by_id") @db.VarChar(30)
  voidedAt     DateTime? @map("voided_at") @db.DateTime(3)
  voidedById   String?   @map("voided_by_id") @db.VarChar(30)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  order        Order     @relation(fields: [orderId], references: [id])
  recordedBy   User?     @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  voidedBy     User?     @relation("PaymentVoider", fields: [voidedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("payments")
}

model EmailMessage {
  id            String    @id @default(cuid()) @db.VarChar(30)
  eventId       String?   @map("event_id") @db.VarChar(30)
  campaignId    String?   @map("campaign_id") @db.VarChar(30)
  priority      Int       @default(0) @db.UnsignedTinyInt
  kind          String    @db.VarChar(24)
  refId         String    @map("ref_id") @db.VarChar(30)
  toEmail       String    @map("to_email") @db.VarChar(254)
  status        String    @default("pending") @db.VarChar(16)
  attempts      Int       @default(0) @db.UnsignedInt
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.DateTime(3)
  lastError     String?   @map("last_error") @db.VarChar(500)
  claimedAt     DateTime? @map("claimed_at") @db.DateTime(3)
  sentAt        DateTime? @map("sent_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  event         Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([status, priority, nextAttemptAt])
  @@index([campaignId, status])
  @@index([sentAt])
  @@index([eventId, status])
  @@index([kind, refId])
  @@map("email_messages")
}

model EventTable {
  id            String            @id @default(cuid()) @db.VarChar(30)
  eventId       String            @map("event_id") @db.VarChar(30)
  name          String            @db.VarChar(100)
  capacity      Int               @db.UnsignedInt
  zone          String?           @db.VarChar(60)
  x             Float             @default(10)
  y             Float             @default(10)
  createdAt     DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  event         Event             @relation(fields: [eventId], references: [id])
  registrations Registration[]    @relation("DraftTable")
  published     Registration[]    @relation("PublishedTable")
  allocations   TableAllocation[]

  @@unique([eventId, name])
  @@index([eventId])
  @@map("event_tables")
}

model TableAllocation {
  id        String     @id @default(cuid()) @db.VarChar(30)
  eventId   String     @map("event_id") @db.VarChar(30)
  orderId   String     @map("order_id") @db.VarChar(30)
  tableId   String     @map("table_id") @db.VarChar(30)
  seats     Int        @db.UnsignedInt
  locked    Boolean    @default(false)
  createdAt DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  table     EventTable @relation(fields: [tableId], references: [id])

  @@unique([orderId, tableId])
  @@index([eventId, locked])
  @@index([tableId])
  @@map("table_allocations")
}

model SeatingPreference {
  eventId  String @map("event_id") @db.VarChar(30)
  groupKey String @map("group_key") @db.VarChar(60)
  zone     String @db.VarChar(60)
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, groupKey])
  @@map("seating_preferences")
}

model EventPlan {
  eventId   String   @id @map("event_id") @db.VarChar(30)
  data      Bytes    @db.MediumBlob
  mimeType  String   @map("mime_type") @db.VarChar(20)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_plans")
}

model Guest {
  id            String         @id @default(cuid()) @db.VarChar(30)
  firstName     String         @map("first_name") @db.VarChar(100)
  lastName      String         @map("last_name") @db.VarChar(140)
  email         String?        @db.VarChar(254)
  phone         String?        @db.VarChar(32)
  organization  String?        @db.VarChar(180)
  contactId     String?        @map("contact_id") @db.VarChar(30)
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  registrations Registration[]
  orders        Order[]        @relation("OrderBuyer")

  @@index([contactId])
  @@index([email])
  @@index([lastName, firstName])
  @@map("guests")
}

model Registration {
  id               String      @id @default(cuid()) @db.VarChar(30)
  eventId          String      @map("event_id") @db.VarChar(30)
  guestId          String      @map("guest_id") @db.VarChar(30)
  orderId          String      @map("order_id") @db.VarChar(30)
  tableId          String?     @map("table_id") @db.VarChar(30)
  seatNumber       Int?        @map("seat_number") @db.UnsignedInt
  folio            String      @db.VarChar(16)
  status           String      @default("pending") @db.VarChar(24)
  registeredAt     DateTime    @default(now()) @map("registered_at") @db.DateTime(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  event            Event       @relation(fields: [eventId], references: [id])
  guest            Guest       @relation(fields: [guestId], references: [id])
  order            Order       @relation(fields: [orderId], references: [id])
  table            EventTable? @relation("DraftTable", fields: [tableId], references: [id])
  publishedTableId String?     @map("published_table_id") @db.VarChar(30)
  publishedTable   EventTable? @relation("PublishedTable", fields: [publishedTableId], references: [id])
  passes           Pass[]
  consents         Consent[]

  @@unique([eventId, folio])
  @@unique([orderId, seatNumber])
  @@index([eventId, status])
  @@index([guestId])
  @@index([tableId])
  @@map("registrations")
}

model Pass {
  id             String       @id @default(cuid()) @db.VarChar(30)
  registrationId String       @map("registration_id") @db.VarChar(30)
  tokenHash      String       @unique @map("token_hash") @db.Char(64)
  status         String       @default("pending") @db.VarChar(24)
  issuedAt       DateTime     @default(now()) @map("issued_at") @db.DateTime(3)
  revokedAt      DateTime?    @map("revoked_at") @db.DateTime(3)
  registration   Registration @relation(fields: [registrationId], references: [id])
  checkin        Checkin?
  incidents      Incident[]

  @@index([registrationId, status])
  @@map("passes")
}

model Checkin {
  id             String      @id @default(cuid()) @db.VarChar(30)
  eventId        String      @map("event_id") @db.VarChar(30)
  passId         String      @unique @map("pass_id") @db.VarChar(30)
  accessPointId  String      @map("access_point_id") @db.VarChar(30)
  operatorUserId String?     @map("operator_user_id") @db.VarChar(30)
  checkedInAt    DateTime    @default(now()) @map("checked_in_at") @db.DateTime(3)
  raffleFolio    String?     @map("raffle_folio") @db.VarChar(16)
  source         String      @default("online") @db.VarChar(16)
  clientEventId  String?     @unique @map("client_event_id") @db.VarChar(40)
  manualReason   String?     @map("manual_reason") @db.VarChar(255)
  event          Event       @relation(fields: [eventId], references: [id])
  pass           Pass        @relation(fields: [passId], references: [id])
  accessPoint    AccessPoint @relation(fields: [accessPointId], references: [id])
  operator       User?       @relation("CheckinOperator", fields: [operatorUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, raffleFolio])
  @@index([eventId, checkedInAt])
  @@index([accessPointId, checkedInAt])
  @@map("checkins")
}

model Incident {
  id             String       @id @default(cuid()) @db.VarChar(30)
  eventId        String       @map("event_id") @db.VarChar(30)
  clientEventId  String?      @unique @map("client_event_id") @db.VarChar(40)
  passId         String?      @map("pass_id") @db.VarChar(30)
  accessPointId  String?      @map("access_point_id") @db.VarChar(30)
  operatorUserId String?      @map("operator_user_id") @db.VarChar(30)
  type           String       @db.VarChar(16)
  status         String       @default("open") @db.VarChar(16)
  description    String       @db.VarChar(500)
  occurredAt     DateTime     @map("occurred_at") @db.DateTime(3)
  resolution     String?      @db.VarChar(500)
  resolvedById   String?      @map("resolved_by_id") @db.VarChar(30)
  resolvedAt     DateTime?    @map("resolved_at") @db.DateTime(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  event          Event        @relation(fields: [eventId], references: [id])
  pass           Pass?        @relation(fields: [passId], references: [id], onDelete: SetNull)
  accessPoint    AccessPoint? @relation(fields: [accessPointId], references: [id], onDelete: SetNull)
  operator       User?        @relation("IncidentOperator", fields: [operatorUserId], references: [id], onDelete: SetNull)
  resolvedBy     User?        @relation("IncidentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([eventId, status, occurredAt])
  @@map("incidents")
}

model EventCounter {
  id           String   @id @default(cuid()) @db.VarChar(30)
  eventId      String   @map("event_id") @db.VarChar(30)
  counterType  String   @map("counter_type") @db.VarChar(32)
  currentValue Int      @default(0) @map("current_value") @db.UnsignedInt
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  event        Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, counterType])
  @@map("event_counters")
}

model User {
  id                String        @id @default(cuid()) @db.VarChar(30)
  email             String        @unique @db.VarChar(254)
  displayName       String        @map("display_name") @db.VarChar(180)
  status            String        @default("invited") @db.VarChar(24)
  roleId            String        @map("role_id") @db.VarChar(30)
  entraTid          String?       @map("entra_tid") @db.VarChar(64)
  entraOid          String?       @map("entra_oid") @db.VarChar(64)
  lastLoginAt       DateTime?     @map("last_login_at") @db.DateTime(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  role              Role          @relation(fields: [roleId], references: [id])
  sessions          AuthSession[]
  checkins          Checkin[]     @relation("CheckinOperator")
  incidentsReported Incident[]    @relation("IncidentOperator")
  incidentsResolved Incident[]    @relation("IncidentResolver")
  ordersCreated     Order[]       @relation("OrderCreator")
  paymentsRecorded  Payment[]     @relation("PaymentRecorder")
  paymentsVoided    Payment[]     @relation("PaymentVoider")
  auditLogs         AuditLog[]
  contactNotes      ContactNote[]
  segments          Segment[]
  campaignsCreated  Campaign[]    @relation("CampaignCreator")
  campaignsSent     Campaign[]    @relation("CampaignSender")
  donationsRecorded Donation[]    @relation("DonationRecorder")
  donationsVoided   Donation[]    @relation("DonationVoider")

  @@unique([entraTid, entraOid])
  @@index([roleId])
  @@map("users")
}

model AuthSession {
  id        String   @id @default(cuid()) @db.VarChar(30)
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.VarChar(30)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model Role {
  id          String           @id @default(cuid()) @db.VarChar(30)
  code        String           @unique @db.VarChar(40)
  name        String           @unique @db.VarChar(80)
  description String?          @db.VarChar(255)
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id") @db.VarChar(30)
  permission String @db.VarChar(64)
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model AccessPoint {
  id        String     @id @default(cuid()) @db.VarChar(30)
  eventId   String     @map("event_id") @db.VarChar(30)
  name      String     @db.VarChar(100)
  status    String     @default("active") @db.VarChar(24)
  createdAt DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  event     Event      @relation(fields: [eventId], references: [id])
  incidents Incident[]
  checkins  Checkin[]

  @@unique([eventId, name])
  @@index([eventId, status])
  @@map("access_points")
}

model Consent {
  id             String       @id @default(cuid()) @db.VarChar(30)
  registrationId String       @map("registration_id") @db.VarChar(30)
  purpose        String       @db.VarChar(80)
  noticeVersion  String       @map("notice_version") @db.VarChar(40)
  granted        Boolean
  consentedAt    DateTime     @map("consented_at") @db.DateTime(3)
  withdrawnAt    DateTime?    @map("withdrawn_at") @db.DateTime(3)
  registration   Registration @relation(fields: [registrationId], references: [id])

  @@index([registrationId, purpose, consentedAt])
  @@map("consents")
}

model AuditLog {
  id         String   @id @default(cuid()) @db.VarChar(30)
  eventId    String?  @map("event_id") @db.VarChar(30)
  userId     String?  @map("user_id") @db.VarChar(30)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(30)
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  event      Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Company {
  id        String     @id @default(cuid()) @db.VarChar(30)
  name      String     @unique @db.VarChar(180)
  website   String?    @db.VarChar(255)
  notes     String?    @db.Text
  createdAt DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  contacts  Contact[]
  donations Donation[]

  @@map("companies")
}

model Contact {
  id                     String              @id @default(cuid()) @db.VarChar(30)
  firstName              String              @map("first_name") @db.VarChar(100)
  lastName               String              @map("last_name") @db.VarChar(140)
  email                  String?             @unique @db.VarChar(254)
  phone                  String?             @db.VarChar(32)
  position               String?             @db.VarChar(120)
  companyId              String?             @map("company_id") @db.VarChar(30)
  source                 String              @default("manual") @db.VarChar(16)
  optedOutAt             DateTime?           @map("opted_out_at") @db.DateTime(3)
  optOutSource           String?             @map("opt_out_source") @db.VarChar(16)
  marketingConsentAt     DateTime?           @map("marketing_consent_at") @db.DateTime(3)
  marketingConsentSource String?             @map("marketing_consent_source") @db.VarChar(16)
  marketingNoticeVersion String?             @map("marketing_notice_version") @db.VarChar(40)
  createdAt              DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  company                Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  guests                 Guest[]
  notes                  ContactNote[]
  donations              Donation[]
  recipients             CampaignRecipient[]

  @@index([lastName, firstName])
  @@index([companyId])
  @@map("contacts")
}

model ContactNote {
  id        String   @id @default(cuid()) @db.VarChar(30)
  contactId String   @map("contact_id") @db.VarChar(30)
  authorId  String?  @map("author_id") @db.VarChar(30)
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt])
  @@map("contact_notes")
}

model Segment {
  id          String     @id @default(cuid()) @db.VarChar(30)
  name        String     @unique @db.VarChar(120)
  description String?    @db.VarChar(255)
  filters     Json
  createdById String?    @map("created_by_id") @db.VarChar(30)
  createdAt   DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  campaigns   Campaign[]

  @@map("segments")
}

model EmailTemplate {
  id        String   @id @default(cuid()) @db.VarChar(30)
  name      String   @unique @db.VarChar(120)
  subject   String   @db.VarChar(180)
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("email_templates")
}

model Campaign {
  id          String              @id @default(cuid()) @db.VarChar(30)
  name        String              @db.VarChar(120)
  subject     String              @db.VarChar(180)
  body        String              @db.Text
  eventId     String?             @map("event_id") @db.VarChar(30)
  segmentId   String?             @map("segment_id") @db.VarChar(30)
  status      String              @default("draft") @db.VarChar(16)
  createdById String?             @map("created_by_id") @db.VarChar(30)
  sentById    String?             @map("sent_by_id") @db.VarChar(30)
  queuedAt    DateTime?           @map("queued_at") @db.DateTime(3)
  cancelledAt DateTime?           @map("cancelled_at") @db.DateTime(3)
  createdAt   DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  event       Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  segment     Segment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  createdBy   User?               @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sentBy      User?               @relation("CampaignSender", fields: [sentById], references: [id], onDelete: SetNull)
  recipients  CampaignRecipient[]
  messages    EmailMessage[]

  @@index([status, createdAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String   @id @default(cuid()) @db.VarChar(30)
  campaignId String   @map("campaign_id") @db.VarChar(30)
  contactId  String   @map("contact_id") @db.VarChar(30)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([contactId])
  @@map("campaign_recipients")
}

model Donation {
  id           String    @id @default(cuid()) @db.VarChar(30)
  contactId    String?   @map("contact_id") @db.VarChar(30)
  companyId    String?   @map("company_id") @db.VarChar(30)
  eventId      String?   @map("event_id") @db.VarChar(30)
  amount       Decimal   @db.Decimal(12, 2)
  currency     String    @default("MXN") @db.Char(3)
  method       String    @db.VarChar(16)
  reference    String?   @db.VarChar(120)
  notes        String?   @db.VarChar(500)
  receivedAt   DateTime  @map("received_at") @db.DateTime(3)
  recordedById String?   @map("recorded_by_id") @db.VarChar(30)
  voidedAt     DateTime? @map("voided_at") @db.DateTime(3)
  voidedById   String?   @map("voided_by_id") @db.VarChar(30)
  voidReason   String?   @map("void_reason") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  contact      Contact?  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  event        Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  recordedBy   User?     @relation("DonationRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  voidedBy     User?     @relation("DonationVoider", fields: [voidedById], references: [id], onDelete: SetNull)

  @@index([receivedAt])
  @@index([contactId])
  @@index([companyId])
  @@index([eventId])
  @@map("donations")
}

{
  "name": "uka-eventos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run build --workspace @uka/shared && concurrently -k -n web,api -c cyan,magenta \"npm run dev --workspace @uka/web\" \"npm run dev --workspace @uka/api\"",
    "start": "npm run start --workspace @uka/api",
    "db:generate": "npm run db:generate --workspace @uka/api",
    "db:migrate": "npm run db:migrate --workspace @uka/api",
    "db:deploy": "npm run db:deploy --workspace @uka/api",
    "db:seed": "npm run db:seed --workspace @uka/api",
    "test:folio-integration": "npm run test:folio-integration --workspace @uka/api",
    "test:folio-coverage": "npm run test:folio-coverage --workspace @uka/api",
    "build": "npm run build --workspace @uka/shared && npm run build --workspace @uka/api && npm run build --workspace @uka/web",
    "lint": "eslint .",
    "typecheck": "npm run build --workspace @uka/shared && npm run typecheck --workspaces --if-present",
    "test": "npm run build --workspace @uka/shared && npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "19.6.1",
    "@commitlint/config-conventional": "19.6.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.11",
    "concurrently": "9.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "15.14.0",
    "husky": "9.1.7",
    "lint-staged": "15.4.3",
    "prettier": "3.4.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,css,md,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
